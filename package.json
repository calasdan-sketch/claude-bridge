{
  "name": "claude-bridge",
  "version": "1.0.0",
  "description": "Unified Claude State Bridge: shared SQLite-backed note store with an HTTP API and an MCP server, so every Claude surface reads/writes the same state.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/start.js",
    "api": "node dist/src/index.js",
    "mcp:stdio": "node dist/src/mcp-stdio.js",
    "mcp:http": "node dist/src/mcp-http.js",
    "doctor": "node dist/src/cli.js doctor",
    "cli": "node dist/src/cli.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "bin": {
    "claude-bridge": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "INSTALL.md",
    "INFRA.md",
    "SECURITY.md",
    "SKILL.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
